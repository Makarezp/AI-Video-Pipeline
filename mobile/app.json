{
    "expo": {
        "name": "Ai Vid Editor",
        "slug": "ai-vid-editor",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "dark",
        "newArchEnabled": true,
        "scheme": "aivideditor",
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#1a1a1a"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.aivideditor.app"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#1a1a1a"
            },
            "edgeToEdgeEnabled": true,
            "package": "com.aivideditor.app"
        },
        "web": {
            "favicon": "./assets/favicon.png",
            "bundler": "metro"
        },
        "plugins": [
            "expo-router",
            [
                "expo-image-picker",
                {
                    "photosPermission": "Allow Ai Vid Editor to access your photos to select videos for editing.",
                    "cameraPermission": "Allow Ai Vid Editor to access your camera to record videos."
                }
            ],
            [
                "expo-av",
                {
                    "microphonePermission": "Allow Ai Vid Editor to access your microphone for video recording."
                }
            ],
            "expo-asset",
            "expo-font",
            [
                "expo-media-library",
                {
                    "photosPermission": "Allow Ai Vid Editor to save edited videos to your photo gallery.",
                    "savePhotosPermission": "Allow Ai Vid Editor to save edited videos to your photo gallery.",
                    "isAccessMediaLocationEnabled": true
                }
            ]
        ]
    }
}